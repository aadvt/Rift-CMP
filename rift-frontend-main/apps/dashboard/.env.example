# ─────────────────────────────────────────────────────────────────────────────
# Point this at your backend and the whole app switches over. That is the only
# change needed — no code edits.
#
# Leave RIFT_API_URL unset and the app runs entirely on fixtures, so you can
# develop and demo the frontend before the backend is reachable.
# ─────────────────────────────────────────────────────────────────────────────

# Base URL of the Rift public API, no trailing slash.
RIFT_API_URL=

# Server-to-server credential, if the API uses a static key during development.
# Never prefix this NEXT_PUBLIC_ — it must not reach the browser.
RIFT_API_TOKEN=

# Optional: request timeout in ms (default 15000).
RIFT_API_TIMEOUT=15000

# Optional: force fixtures even when RIFT_API_URL is set. Useful for demos.
RIFT_USE_FIXTURES=false

# Optional: region codes for the markets this organisation serves, comma
# separated (e.g. EU,IN,US-CA). The policy engine resolves which jurisdictions
# apply from these. Nothing here geolocates a visitor — a target market is a
# statement the business makes about itself.
RIFT_MARKETS=
