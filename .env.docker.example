# Copy to `.env` and fill in. `docker compose up` reads it automatically.

# Postgres connection string. Neon works as-is; any Postgres 15+ will do.
# Rift does not run a database for you — consent records are evidence, and
# evidence should not live somewhere `docker compose down -v` can erase.
DATABASE_URL=

# Optional. Regions this organisation serves, comma separated, e.g. EU,IN,US-CA.
# The policy engine resolves which regulations apply from these. Nothing here
# geolocates a visitor: a target market is a statement the business makes about
# itself, never something inferred from whoever is browsing.
RIFT_MARKETS=

# ─── Signed consent proofs (optional) ────────────────────────────────────────
#
# Leave all three unset and Rift still records consent and still issues proofs —
# they carry integrity and chain links and report themselves as *unsigned*. What
# you lose is authenticity: without a key, a proof evidences that the record has
# not changed, but not that Rift produced it. That is a real difference and every
# surface says which one you have.
#
# Generate a pair:
#   openssl genpkey -algorithm ed25519 -out rift-proof-2026-09.pem
#   openssl pkey -in rift-proof-2026-09.pem -pubout -out rift-proof-2026-09.pub
#
# The private key must never be committed, never reach a browser, and never be
# returned by an API. Nothing in Rift logs it; keep it in a secret manager.

# Ed25519 private key, PKCS#8 PEM. Base64 of the PEM is also accepted, because
# newlines survive neither this file nor most secret managers.
RIFT_PROOF_SIGNING_KEY=

# The id recorded on every proof this key signs. Required alongside the key —
# without it a proof cannot say which key made it, and rotation becomes
# impossible after the fact.
RIFT_PROOF_KEY_ID=

# Every public key that should still be trusted, as JSON:
#   [{"keyId":"k-2026-01","publicKey":"-----BEGIN PUBLIC KEY-----..."},
#    {"keyId":"k-2026-09","publicKey":"..."}]
#
# To rotate: APPEND the new public key, keep every existing entry, then point
# RIFT_PROOF_KEY_ID and RIFT_PROOF_SIGNING_KEY at the new pair. Dropping a
# retired key silently turns every proof it signed from "valid" into
# "unknown key".
#
# To revoke, mark the entry {"revoked": true} rather than deleting it, so
# verification can report "signature genuine, key revoked" instead of "unknown
# key" — different facts an auditor needs to tell apart.
#
# If this is unset but a signing key is configured, the matching public key is
# derived from the private one, so a first deployment can verify its own proofs.
RIFT_PROOF_PUBLIC_KEYS=
