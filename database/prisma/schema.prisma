generator client {
  provider = "prisma-client-js"
  output   = "../generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// A tenant. Every website belongs to exactly one organisation, and the
/// organisation is the boundary that isolation is enforced against.
model Organisation {
  id            String   @id @default(uuid())
  name          String
  slug          String   @unique
  /// SHA-256 of the server-side secret key (`sk_...`). The plaintext secret is
  /// shown once at creation and never stored.
  secretKeyHash String   @unique @map("secret_key_hash")
  createdAt     DateTime @default(now()) @map("created_at")

  websites   Website[]
  purposes   Purpose[]
  policies   Policy[]
  notices    Notice[]
  recipients DataRecipient[]
  dashboardSessions DashboardSession[]
  scans      Scan[]

  @@map("organisations")
}

model Website {
  id             String   @id @default(uuid())
  organisationId String   @map("organisation_id")
  name           String
  domain         String
  /// Public client identifier (`pk_...`). Safe to embed in browser code; it
  /// authorises ingestion for this one site and nothing else.
  publicKey      String   @unique @map("public_key")
  isActive       Boolean  @default(true) @map("is_active")
  /// Purpose code that must currently resolve to GRANTED before this site's
  /// analytics events are accepted. Null - the default - means the ingestion
  /// plane applies no consent gate, which is the behaviour every site had
  /// before Phase 6A. See docs/security.md.
  analyticsConsentPurpose String? @map("analytics_consent_purpose")
  /// Extra browser origins accepted alongside `domain`, as full origins
  /// (`https://app.example.com`, `http://localhost:5173`). Defence in depth:
  /// an `Origin` header is only ever evidence about a *browser*.
  allowedOrigins String[] @default([]) @map("allowed_origins")
  createdAt      DateTime @default(now()) @map("created_at")

  organisation   Organisation    @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  sessions            Session[]
  events              Event[]
  principals          Principal[]
  consentRecords      ConsentRecord[]
  transferAuthorisations TransferAuthorisation[]
  discoveredComponents DiscoveredComponent[]
  discoveredStorage    DiscoveredStorage[]
  discoveryViolations  DiscoveryViolation[]
  consentSessions      ConsentSession[]
  scans                Scan[]

  @@unique([id, organisationId])
  @@index([organisationId])
  @@map("websites")
}

model Session {
  id           String   @id @default(uuid())
  siteId       String   @map("site_id")
  startedAt    DateTime @default(now()) @map("started_at")
  lastActivity DateTime @map("last_activity")

  website Website @relation(fields: [siteId], references: [id], onDelete: Cascade)
  events  Event[]

  @@unique([id, siteId])
  // Covers lookups by site alone as a leading-column prefix, so a separate
  // [siteId] index would be redundant.
  @@index([siteId, lastActivity])
  @@map("sessions")
}

model Event {
  id         String   @id @default(uuid())
  eventId    String   @unique @map("event_id")
  siteId     String   @map("site_id")
  sessionId  String   @map("session_id")
  eventType  String   @map("event_type")
  name       String?
  eventTime  DateTime @map("event_time")
  pageUrl    String   @map("page_url")
  pageTitle  String   @map("page_title")
  referrer   String?
  deviceType String   @map("device_type")
  browser    String
  os         String
  properties Json?
  receivedAt DateTime @default(now()) @map("received_at")

  website Website @relation(fields: [siteId], references: [id], onDelete: Cascade)
  /// Composite FK: an event can only reference a session that belongs to the
  /// same site. This makes cross-tenant session reuse impossible at the DB level.
  session Session @relation(fields: [sessionId, siteId], references: [id, siteId], onDelete: Cascade)

  // Access patterns required by docs/database-schema.md: filtering by site_id,
  // event_time and event_type, and joins on session_id. Postgres does not
  // index foreign keys automatically, so these are declared explicitly.
  @@index([siteId, eventTime])
  @@index([siteId, eventType, eventTime])
  @@index([sessionId])
  @@map("events")
}

// ─── Consent domain ──────────────────────────────────────────────────────────
//
// Deliberately generic. These models encode *structure* (who decided what, about
// which purpose, under which notice, when) and no legal rules. A compliance
// engine for any particular regulation sits above these concepts later.
//
// The consent domain is kept separate from the analytics domain: nothing here
// references `Session` or `Event`, and no consent state is copied onto analytics
// rows. The link, when one is needed, is made through `Principal`.

/// A data principal - the person a consent decision belongs to.
///
/// Scoped to a site, because that is the grain the SDK authenticates at. For the
/// MVP a principal is anonymous: `externalId` is an opaque, high-entropy id the
/// SDK stores in the browser. `kind` allows later promotion to an identified
/// principal without a schema change.
model Principal {
  id         String   @id @default(uuid())
  siteId     String   @map("site_id")
  /// The site's own identifier for this person. Opaque to us.
  externalId String   @map("external_id")
  /// "anonymous" | "identified" - open-ended by design.
  kind       String   @default("anonymous")
  /// SHA-256 of the browser-held principal secret minted when this principal
  /// first opened a consent session. Proving possession of it is what stops one
  /// client recording decisions on behalf of another principal whose id it has
  /// merely learned. Null for principals created before Phase 6A, or by the
  /// seed script / a bulk import - see the trust-on-first-use note in
  /// docs/security.md.
  secretHash String?  @map("secret_hash")
  createdAt  DateTime @default(now()) @map("created_at")

  website         Website          @relation(fields: [siteId], references: [id], onDelete: Cascade)
  consentRecords  ConsentRecord[]
  consentSessions ConsentSession[]
  transferAuthorisations TransferAuthorisation[]

  @@unique([siteId, externalId])
  @@unique([id, siteId])
  @@map("principals")
}

/// Something a fiduciary uses data for. Referenced by stable `code`, so the SDK
/// and notices can name a purpose without knowing its UUID.
model Purpose {
  id             String   @id @default(uuid())
  organisationId String   @map("organisation_id")
  code           String
  name           String
  description    String
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")

  organisation   Organisation    @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  noticePurposes NoticePurpose[]
  consentRecords ConsentRecord[]
  transferAuthorisations TransferAuthorisation[]

  @@unique([organisationId, code])
  @@unique([id, organisationId])
  @@map("purposes")
}

/// A policy document owned by a fiduciary. The text itself lives in versions.
model Policy {
  id             String   @id @default(uuid())
  organisationId String   @map("organisation_id")
  code           String
  name           String
  createdAt      DateTime @default(now()) @map("created_at")

  organisation Organisation    @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  versions     PolicyVersion[]

  @@unique([organisationId, code])
  @@unique([id, organisationId])
  @@map("policies")
}

/// An immutable version of a policy. Consent is always recorded against the
/// version that was in force, so the audit trail stays meaningful after the
/// policy text changes.
model PolicyVersion {
  id             String   @id @default(uuid())
  organisationId String   @map("organisation_id")
  policyId       String   @map("policy_id")
  version        String
  documentUrl    String?  @map("document_url")
  /// Digest of the published text, so a stored version can be proven unchanged.
  contentHash    String?  @map("content_hash")
  publishedAt    DateTime @default(now()) @map("published_at")

  policy         Policy          @relation(fields: [policyId, organisationId], references: [id, organisationId], onDelete: Cascade)
  notices        Notice[]
  consentRecords ConsentRecord[]

  @@unique([policyId, version])
  @@unique([id, organisationId])
  @@index([organisationId])
  @@map("policy_versions")
}

/// What was actually shown to a principal at collection time: a policy version,
/// in a locale, disclosing a specific set of purposes.
model Notice {
  id              String   @id @default(uuid())
  organisationId  String   @map("organisation_id")
  policyVersionId String   @map("policy_version_id")
  version         String
  locale          String   @default("en")
  publishedAt     DateTime @default(now()) @map("published_at")

  organisation   Organisation    @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  policyVersion  PolicyVersion   @relation(fields: [policyVersionId, organisationId], references: [id, organisationId], onDelete: NoAction)
  purposes       NoticePurpose[]
  consentRecords ConsentRecord[]

  @@unique([organisationId, version, locale])
  @@unique([id, organisationId])
  @@map("notices")
}

/// Which purposes a notice disclosed.
model NoticePurpose {
  noticeId  String @map("notice_id")
  purposeId String @map("purpose_id")

  notice  Notice  @relation(fields: [noticeId], references: [id], onDelete: Cascade)
  purpose Purpose @relation(fields: [purposeId], references: [id], onDelete: Cascade)

  @@id([noticeId, purposeId])
  @@index([purposeId])
  @@map("notice_purposes")
}

/// One immutable consent decision. This table is append-only: a database trigger
/// rejects UPDATE, so a recorded decision can never be rewritten or silently
/// overwritten. DELETE is not blocked, because tenant offboarding cascades from
/// `organisations`; retention and erasure are a separate concern from
/// immutability. "Current consent" is derived as the newest record per
/// (principal, purpose) - it is never stored as a mutable flag.
model ConsentRecord {
  id              String   @id @default(uuid())
  organisationId  String   @map("organisation_id")
  siteId          String   @map("site_id")
  principalId     String   @map("principal_id")
  purposeId       String   @map("purpose_id")
  noticeId        String?  @map("notice_id")
  /// Snapshot of the policy version in force, so the record stands alone even if
  /// the notice is later superseded.
  policyVersionId String?  @map("policy_version_id")
  /// GRANTED | DENIED | WITHDRAWN. A string rather than an enum so new decision
  /// types can be added without a type migration; the API validates the set.
  status          String
  /// Where the decision came from, e.g. "sdk", "api", "import".
  source          String   @default("api")
  /// When the principal decided.
  decidedAt       DateTime @map("decided_at")
  /// When we durably stored it. Never equal to decidedAt for imported records.
  recordedAt      DateTime @default(now()) @map("recorded_at")
  /// Free-form context (UI surface, SDK version...). Never legal rules.
  metadata        Json?

  // Composite foreign keys keep every reference inside one tenant, in the same
  // way Phase 1 ties an event's session to its site.
  website       Website        @relation(fields: [siteId, organisationId], references: [id, organisationId], onDelete: Cascade)
  principal     Principal      @relation(fields: [principalId, siteId], references: [id, siteId], onDelete: Cascade)
  purpose       Purpose        @relation(fields: [purposeId, organisationId], references: [id, organisationId], onDelete: NoAction)
  notice        Notice?        @relation(fields: [noticeId, organisationId], references: [id, organisationId], onDelete: NoAction)
  policyVersion PolicyVersion? @relation(fields: [policyVersionId, organisationId], references: [id, organisationId], onDelete: NoAction)
  transferAuthorisations TransferAuthorisation[]

  @@unique([id, organisationId])
  @@index([principalId, purposeId, decidedAt])
  @@index([siteId, decidedAt])
  @@index([organisationId, decidedAt])
  @@index([purposeId])
  @@map("consent_records")
}

// --- Secure data routing (Phase 3 prototype) --------------------------------
//
// Rift relays sealed payloads between fiduciaries. It stores ciphertext and
// routing metadata and nothing else: no plaintext, and no key material capable
// of decrypting anything. See docs/secure-transfer.md for the trust model.

/// A target fiduciary a source organisation is permitted to send data to.
model DataRecipient {
  id             String   @id @default(uuid())
  organisationId String   @map("organisation_id")
  code           String
  name           String
  /// The target's X25519 public key, base64 SPKI. Public by definition - the
  /// matching private key exists only inside the target fiduciary.
  publicKey      String   @map("public_key")
  /// Recorded per recipient so the construction can change without guessing how
  /// existing envelopes were sealed.
  algorithm      String
  /// SHA-256 of the `rk_...` delivery credential the target presents to collect
  /// envelopes. The plaintext credential is shown once and never stored.
  deliveryKeyHash String  @unique @map("delivery_key_hash")
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")

  organisation   Organisation            @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  authorisations TransferAuthorisation[]

  @@unique([organisationId, code])
  @@unique([id, organisationId])
  @@map("data_recipients")
}

/// Permission to make one specific transfer. Single use, time bounded, and tied
/// to the exact consent decision it relied on.
model TransferAuthorisation {
  id              String   @id @default(uuid())
  organisationId  String   @map("organisation_id")
  siteId          String   @map("site_id")
  principalId     String   @map("principal_id")
  purposeId       String   @map("purpose_id")
  recipientId     String   @map("recipient_id")
  /// The specific decision relied upon, not a boolean. Phase 2's log is
  /// append-only, so an auditor can always see what justified the transfer.
  consentRecordId String   @map("consent_record_id")
  /// High entropy, single use, and part of the envelope's authenticated data.
  nonce           String   @unique
  /// AUTHORISED | CONSUMED | EXPIRED
  status          String   @default("AUTHORISED")
  expiresAt       DateTime @map("expires_at")
  createdAt       DateTime @default(now()) @map("created_at")

  website       Website       @relation(fields: [siteId, organisationId], references: [id, organisationId], onDelete: Cascade)
  principal     Principal     @relation(fields: [principalId, siteId], references: [id, siteId], onDelete: Cascade)
  purpose       Purpose       @relation(fields: [purposeId, organisationId], references: [id, organisationId], onDelete: NoAction)
  recipient     DataRecipient @relation(fields: [recipientId, organisationId], references: [id, organisationId], onDelete: NoAction)
  consentRecord ConsentRecord @relation(fields: [consentRecordId, organisationId], references: [id, organisationId], onDelete: NoAction)
  transfer      TransferRecord?

  @@unique([id, organisationId])
  @@index([organisationId, createdAt])
  @@index([siteId, status])
  @@map("transfer_authorisations")
}

/// What actually happened, plus the sealed payload while it is in transit.
///
/// Every payload column here is opaque to Rift. There is deliberately no column
/// for plaintext and none for a decryption key.
model TransferRecord {
  id              String   @id @default(uuid())
  organisationId  String   @map("organisation_id")
  /// Unique: one transfer per authorisation. This is the database-level half of
  /// replay prevention - a second submission cannot race past the status check.
  authorisationId String   @unique @map("authorisation_id")

  /// The sealed envelope. base64, unreadable without the recipient private key.
  ciphertext         String @map("ciphertext")
  iv                 String
  authTag            String @map("auth_tag")
  ephemeralPublicKey String @map("ephemeral_public_key")

  /// Integrity and accounting, computed without inspecting the content.
  ciphertextSha256 String @map("ciphertext_sha256")
  payloadBytes     Int    @map("payload_bytes")

  /// RECORDED | DELIVERED | FAILED
  status        String    @default("RECORDED")
  failureReason String?   @map("failure_reason")
  recordedAt    DateTime  @default(now()) @map("recorded_at")
  deliveredAt   DateTime? @map("delivered_at")

  // Composite, so a transfer's tenant must match its authorisation's tenant.
  // `authorisationId` stays unique on its own, which is what enforces one
  // transfer per authorisation.
  authorisation TransferAuthorisation @relation(fields: [authorisationId, organisationId], references: [id, organisationId], onDelete: Cascade)

  // Required by Prisma for the composite one-to-one above. The standalone
  // `@unique` on `authorisationId` is what actually guarantees one transfer per
  // authorisation; this pair additionally ties the transfer to its tenant.
  @@unique([authorisationId, organisationId])
  @@index([organisationId, recordedAt])
  @@map("transfer_records")
}

// ─── Discovery domain ────────────────────────────────────────────────────────
//
// What is actually running on a customer's pages, where it sends data, and
// whether any of it fired without consent. Populated by the SDK from inside real
// page views rather than by a crawler, which is what makes the violation record
// below possible at all: only code present in the page can observe that a
// request genuinely left the browser.
//
// Site-scoped, like the analytics domain. Deliberately *not* joined to
// `Principal`: a violation records that a destination was contacted under a
// non-granted purpose, never which person was on the page. Attributing these to
// individuals would manufacture exactly the behavioural profile the platform
// exists to avoid.

/// One destination a site's pages contact, aggregated across page views.
model DiscoveredComponent {
  id     String @id @default(uuid())
  siteId String @map("site_id")

  /// Hostname only. The SDK strips query strings and fragments before sending.
  host String
  /// script | image | iframe | fetch | xhr | beacon | stylesheet | media | font | other
  kind String
  /// The script this was attributed to, as `host/file`. Null when the browser
  /// gave no usable stack - common for requests issued by served markup.
  initiator  String?
  samplePath String? @map("sample_path")
  pageUrl    String  @map("page_url")

  /// False when the host equals the page's own origin.
  isThirdParty Boolean @map("is_third_party")
  requestCount Int     @default(1) @map("request_count")

  /// Server-side classification. Null vendor means unmatched, which is surfaced
  /// as "unclassified" rather than treated as safe.
  vendor             String?
  category           String?
  destinationCountry String? @map("destination_country")
  crossesBorder      Boolean @default(false) @map("crosses_border")

  firstSeen DateTime @map("first_seen")
  lastSeen  DateTime @map("last_seen")

  website Website @relation(fields: [siteId], references: [id], onDelete: Cascade)

  /// One row per destination per kind per site, so repeated page views update a
  /// count instead of growing the table without bound.
  @@unique([siteId, host, kind])
  @@index([siteId, lastSeen])
  @@index([siteId, isThirdParty])
  @@map("discovered_components")
}

/// A storage key a site's pages write. Names only - never values.
model DiscoveredStorage {
  id     String @id @default(uuid())
  siteId String @map("site_id")

  /// cookie | local_storage | session_storage
  kind   String
  name   String
  writer String?

  firstSeen DateTime @map("first_seen")
  lastSeen  DateTime @map("last_seen")

  website Website @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@unique([siteId, kind, name])
  @@index([siteId, lastSeen])
  @@map("discovered_storage")
}

/// A destination contacted while consent for its purpose was not granted.
///
/// Stored rather than derived, because effective consent is "newest decision
/// wins": the state at the moment of the request cannot be reconstructed later.
/// This is the evidentiary record a crawler-based scanner cannot produce.
model DiscoveryViolation {
  id     String @id @default(uuid())
  siteId String @map("site_id")

  host        String
  purposeCode String @map("purpose_code")
  /// The effective status at the moment of observation: DENIED or WITHDRAWN.
  consentStatus String @map("consent_status")
  pageUrl       String @map("page_url")

  observedAt DateTime @map("observed_at")
  recordedAt DateTime @default(now()) @map("recorded_at")

  website Website @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@index([siteId, observedAt])
  @@map("discovery_violations")
}

// ─── Security: consent sessions and dashboard sessions ───────────────────────
//
// Phase 6A. Both are *credential* storage, not product data: nothing here is
// part of the consent, analytics, routing or discovery vocabulary, and no read
// model projects them. See docs/security.md.

/// A browser's proof that it controls a principal, held for a short window.
///
/// The site public key ships in page source, so it cannot be evidence that a
/// human decided anything. A consent session is what carries that evidence: it
/// is minted only after the caller proves possession of the principal secret
/// (or mints a brand new principal), it is bound to one site and one principal,
/// it expires, and the number of decisions it may record is capped.
///
/// Only the SHA-256 digest of the token is stored, exactly as for `sk_` and
/// `rk_` credentials: a database dump yields no usable session token.
model ConsentSession {
  id          String   @id @default(uuid())
  siteId      String   @map("site_id")
  principalId String   @map("principal_id")
  /// SHA-256 of the opaque `cs_...` token handed to the browser.
  tokenHash   String   @unique @map("token_hash")
  /// The `Origin` the session was opened from, when the browser sent one.
  /// Recorded for forensics; never treated as proof of anything.
  origin      String?
  /// Decisions recorded through this session, against `maxDecisions`.
  decisionCount Int    @default(0) @map("decision_count")
  maxDecisions  Int    @map("max_decisions")
  issuedAt    DateTime @default(now()) @map("issued_at")
  expiresAt   DateTime @map("expires_at")
  revokedAt   DateTime? @map("revoked_at")

  /// Composite, so a session can never name a principal from another site.
  website   Website   @relation(fields: [siteId], references: [id], onDelete: Cascade)
  principal Principal @relation(fields: [principalId, siteId], references: [id, siteId], onDelete: Cascade)

  @@index([siteId, expiresAt])
  @@index([principalId])
  @@map("consent_sessions")
}

/// One signed-in dashboard operator session.
///
/// The cookie used to hold the organisation secret verbatim. It now holds an
/// opaque token, and the secret is sealed at rest with a key derived from that
/// token: the database alone cannot recover it, and the cookie alone cannot
/// either. Deleting the row revokes the session, which the old design had no
/// way to do. It is still one shared organisation credential behind it - see
/// the limitation in docs/security.md.
model DashboardSession {
  id             String   @id @default(uuid())
  organisationId String   @map("organisation_id")
  /// SHA-256 of the opaque `ds_...` cookie token.
  tokenHash      String   @unique @map("token_hash")
  /// AES-256-GCM ciphertext of the organisation secret, base64.
  sealedSecret   String   @map("sealed_secret")
  sealIv         String   @map("seal_iv")
  sealTag        String   @map("seal_tag")
  createdAt      DateTime @default(now()) @map("created_at")
  lastSeenAt     DateTime @default(now()) @map("last_seen_at")
  expiresAt      DateTime @map("expires_at")
  revokedAt      DateTime? @map("revoked_at")

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  @@index([organisationId])
  @@map("dashboard_sessions")
}

// ─── Scanner: Playwright website scans ───────────────────────────────────────
//
// Phase 8A. A *complement* to the in-page discovery domain above, not a
// replacement for it, and the two answer different questions on purpose:
//
//   - `discovered_components` records what a real visitor's browser actually
//     did, which is the only way to evidence that a tracker fired while consent
//     was withdrawn. It needs the tag installed and only ever sees pages people
//     actually visit.
//   - `scans` records what a robot saw on a site at one moment, logged out.
//     It works before signup, which is what onboarding needs, and it can reach
//     pages nobody has visited yet.
//
// They are deliberately not merged. Collapsing "observed in production" and
// "observed by a crawler" into one table would destroy the distinction that
// makes the first evidentiary, and docs/discovery.md is explicit that a crawler
// structurally cannot produce that evidence.
//
// Every row here is an *observation*, never a legal conclusion. No table in
// this section carries a "consent required" column, and that absence is the
// architecture: the compliance layer reads these rows and decides.

/// One scan of one site, and its lifecycle.
model Scan {
  id     String @id @default(uuid())
  siteId String @map("site_id")
  /// Denormalised from the site so every tenant-scoped read filters on an
  /// indexed column here rather than joining through `websites` first.
  organisationId String @map("organisation_id")

  /// queued | running | completed | failed | cancelled
  status String @default("queued")
  /// baseline | necessary_only | analytics | advertising | all.
  /// Only `baseline` is implemented; the column exists so an observation is
  /// stamped with the state it was made under from the very first row.
  mode String @default("baseline")

  startUrl       String  @map("start_url")
  crawlerVersion String? @map("crawler_version")
  /// The resolved limits the crawl actually ran with, so a result can be read
  /// against the budget that produced it rather than against today's defaults.
  config Json?

  /// Machine-readable failure code plus a truncated message. Never a stack.
  errorCode    String? @map("error_code")
  errorMessage String? @map("error_message")

  /// Denormalised counts, so the onboarding UI can render a summary without
  /// aggregating six child tables on every poll.
  pagesDiscovered      Int @default(0) @map("pages_discovered")
  pagesScanned         Int @default(0) @map("pages_scanned")
  pagesFailed          Int @default(0) @map("pages_failed")
  cookiesFound         Int @default(0) @map("cookies_found")
  scriptsFound         Int @default(0) @map("scripts_found")
  requestsObserved     Int @default(0) @map("requests_observed")
  storageItemsFound    Int @default(0) @map("storage_items_found")
  thirdPartyDomains    Int @default(0) @map("third_party_domains")
  technologiesDetected Int @default(0) @map("technologies_detected")

  consentUiDetected Boolean @default(false) @map("consent_ui_detected")
  /// The signals behind `consent_ui_detected`, so the UI can answer "why".
  consentUiSignals Json? @map("consent_ui_signals")

  /// Which limit, if any, stopped the crawl early. Null means it finished
  /// naturally; anything else means the counts are a floor, not a total.
  limitReached String? @map("limit_reached")
  robotsSource String? @map("robots_source")

  createdAt   DateTime  @default(now()) @map("created_at")
  startedAt   DateTime? @map("started_at")
  completedAt DateTime? @map("completed_at")

  website      Website      @relation(fields: [siteId], references: [id], onDelete: Cascade)
  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  pages        ScanPage[]
  cookies      ScanCookie[]
  scripts      ScanScript[]
  requests     ScanRequest[]
  storage      ScanStorage[]
  technologies ScanTechnology[]

  /// Tenant-leading, so a scoped list never scans another tenant's rows.
  @@index([organisationId, createdAt])
  @@index([siteId, createdAt])
  /// The worker claims work with this; status leads because the queue is short
  /// and the table is not.
  @@index([status, createdAt])
  @@map("scans")
}

/// One page the crawler attempted. A failed page is still a row: "we tried and
/// could not" is information the onboarding UI needs to show honestly.
model ScanPage {
  id     String @id @default(uuid())
  scanId String @map("scan_id")

  url         String
  finalUrl    String? @map("final_url")
  status      Int?
  title       String?
  contentType String? @map("content_type")
  depth       Int
  /// Empty array when there were no redirects.
  redirectChain Json    @map("redirect_chain")
  rendered      Boolean
  /// Null when the page rendered. Otherwise a short reason - `timeout`,
  /// `disallowed_by_robots`, `ssrf_blocked:private_address`.
  error      String?
  durationMs Int      @map("duration_ms")
  startedAt  DateTime @map("started_at")

  scan Scan @relation(fields: [scanId], references: [id], onDelete: Cascade)

  @@unique([scanId, url])
  @@index([scanId])
  @@map("scan_pages")
}

/// A cookie present in the browser context after the crawl.
///
/// **No value column exists.** Playwright hands the value over whether we want
/// it or not; it is discarded at the crawler boundary and there is deliberately
/// nowhere here to put it, so a later change cannot start persisting one by
/// accident without someone first adding a column and explaining why.
model ScanCookie {
  id     String @id @default(uuid())
  scanId String @map("scan_id")

  name     String
  domain   String
  path     String
  expires  DateTime?
  secure   Boolean
  httpOnly Boolean   @map("http_only")
  sameSite String?   @map("same_site")

  isThirdParty Boolean @map("is_third_party")
  firstSeenOn  String  @map("first_seen_on")

  scan Scan @relation(fields: [scanId], references: [id], onDelete: Cascade)

  @@unique([scanId, name, domain, path])
  @@index([scanId])
  @@map("scan_cookies")
}

/// A script the page loaded. Inline scripts are counted, never captured.
model ScanScript {
  id     String @id @default(uuid())
  scanId String @map("scan_id")

  /// Null for inline scripts - the body is deliberately not stored.
  url          String?
  host         String?
  inline       Boolean
  isThirdParty Boolean @map("is_third_party")
  observedOn   String  @map("observed_on")

  scan Scan @relation(fields: [scanId], references: [id], onDelete: Cascade)

  @@index([scanId])
  @@index([scanId, host])
  @@map("scan_scripts")
}

/// Network activity, aggregated per host, resource type and method.
///
/// Aggregated rather than one row per request, following the same reasoning as
/// `discovered_components`: a single page can issue hundreds of requests to one
/// host, and storing each would let one hostile page write unbounded rows while
/// telling an operator nothing the count does not already say. Query strings and
/// fragments are stripped at capture, and no header, body or cookie is recorded.
model ScanRequest {
  id     String @id @default(uuid())
  scanId String @map("scan_id")

  host         String
  resourceType String  @map("resource_type")
  method       String
  /// Origin + path of one representative request. Never a query string.
  samplePath   String? @map("sample_path")
  isThirdParty Boolean @map("is_third_party")
  requestCount Int     @default(1) @map("request_count")
  failedCount  Int     @default(0) @map("failed_count")
  /// A representative status; requests to one host can differ.
  status Int?

  scan Scan @relation(fields: [scanId], references: [id], onDelete: Cascade)

  @@unique([scanId, host, resourceType, method])
  @@index([scanId])
  @@index([scanId, isThirdParty])
  @@map("scan_requests")
}

/// Browser storage **key names**. Values are never read from the page.
model ScanStorage {
  id     String @id @default(uuid())
  scanId String @map("scan_id")

  /// local_storage | session_storage | indexed_db
  kind       String
  name       String
  origin     String
  observedOn String @map("observed_on")

  scan Scan @relation(fields: [scanId], references: [id], onDelete: Cascade)

  @@unique([scanId, kind, name, origin])
  @@index([scanId])
  @@map("scan_storage")
}

/// A technology a detector identified, with the evidence that identified it.
///
/// `evidence` and `confidence` are not decoration. An onboarding UI has to be
/// able to answer "why do you think my site uses this?", and a classification a
/// customer cannot interrogate is one they cannot correct.
model ScanTechnology {
  id     String @id @default(uuid())
  scanId String @map("scan_id")

  detectorId String @map("detector_id")
  name       String
  category   String
  /// high | medium | low. Host-only matches are `low` on purpose.
  confidence String
  /// Array of `{ type, value }`. Bounded per finding by the crawler.
  evidence Json

  destinationCountry String? @map("destination_country")
  crossesBorder      Boolean @default(false) @map("crosses_border")

  scan Scan @relation(fields: [scanId], references: [id], onDelete: Cascade)

  @@unique([scanId, detectorId])
  @@index([scanId])
  @@index([scanId, category])
  @@map("scan_technologies")
}
