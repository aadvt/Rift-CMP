{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://rift-cmp.local/schemas/policy-version.schema.json",
    "title": "Privacy Policy Version",
    "description": "Schema for versioning regulation requirements and policy interpretations over time.",
    "type": "object",
    "required": [
        "policy_version",
        "regime",
        "status",
        "effective_from",
        "source_ids"
    ],
    "properties": {
        "policy_version": {
            "type": "string",
            "minLength": 1
        },
        "regime": {
            "type": "string",
            "minLength": 1
        },
        "status": {
            "type": "string",
            "enum": [
                "draft",
                "current",
                "superseded",
                "archived"
            ]
        },
        "effective_from": {
            "type": [
                "string",
                "null"
            ],
            "format": "date"
        },
        "effective_to": {
            "type": [
                "string",
                "null"
            ],
            "format": "date"
        },
        "publication_date": {
            "type": [
                "string",
                "null"
            ],
            "format": "date"
        },
        "description": {
            "type": [
                "string",
                "null"
            ]
        },
        "changes": {
            "type": "array",
            "items": {
                "type": "string"
            }
        },
        "source_ids": {
            "type": "array",
            "minItems": 1,
            "items": {
                "type": "string",
                "minLength": 1
            }
        },
        "notes": {
            "type": [
                "string",
                "null"
            ]
        }
    },
    "additionalProperties": false
}