{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://example.com/rift-cmp/regulations/schemas/policy-version.schema.json",
    "title": "Privacy Policy Version",
    "type": "object",
    "required": [
        "policy_version_id",
        "regime",
        "version",
        "status",
        "effective_from"
    ],
    "properties": {
        "policy_version_id": {
            "type": "string",
            "minLength": 1
        },
        "regime": {
            "type": "string",
            "minLength": 1
        },
        "version": {
            "type": "string",
            "minLength": 1
        },
        "status": {
            "type": "string",
            "enum": [
                "draft",
                "active",
                "superseded",
                "withdrawn"
            ]
        },
        "legal_publication_date": {
            "type": [
                "string",
                "null"
            ],
            "format": "date"
        },
        "effective_from": {
            "type": "string",
            "format": "date"
        },
        "effective_to": {
            "type": [
                "string",
                "null"
            ],
            "format": "date"
        },
        "policy_interpretation_version": {
            "type": "string",
            "minLength": 1
        },
        "source_ids": {
            "type": "array",
            "minItems": 1,
            "items": {
                "type": "string"
            }
        },
        "change_summary": {
            "type": [
                "string",
                "null"
            ]
        },
        "notes": {
            "type": [
                "string",
                "null"
            ]
        }
    },
    "additionalProperties": false
}