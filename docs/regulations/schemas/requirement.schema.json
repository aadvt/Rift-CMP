{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://example.com/rift-cmp/regulations/schemas/requirement.schema.json",
    "title": "Privacy Regulation Requirement",
    "type": "object",
    "required": [
        "requirement_id",
        "regime",
        "topic",
        "requirement",
        "applicability",
        "legal_bases",
        "purposes",
        "data_categories",
        "contexts",
        "exceptions",
        "effective_from",
        "effective_to",
        "policy_version",
        "source_ids"
    ],
    "properties": {
        "requirement_id": {
            "type": "string",
            "minLength": 1
        },
        "regime": {
            "type": "string",
            "minLength": 1
        },
        "topic": {
            "type": "string",
            "minLength": 1
        },
        "requirement": {
            "type": "string",
            "minLength": 1
        },
        "requirement_type": {
            "type": "string",
            "$comment": "Values enumerated in vocabulary.json -> requirement_types.values."
        },
        "authority_level": {
            "type": "string",
            "$comment": "Values enumerated in vocabulary.json -> authority_levels.values."
        },
        "applicability": {
            "type": "object",
            "required": [
                "applies",
                "triggers",
                "covered_actors"
            ],
            "properties": {
                "applies": {
                    "type": "boolean"
                },
                "triggers": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                },
                "covered_actors": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                },
                "thresholds": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                },
                "territorial_triggers": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                },
                "sector_conditions": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                },
                "data_subject_conditions": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                },
                "covered_actors_canonical": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    },
                    "$comment": "Added by tools/normalise.mjs."
                }
            },
            "additionalProperties": false
        },
        "legal_bases": {
            "type": "array",
            "items": {
                "type": "string"
            }
        },
        "purposes": {
            "type": "array",
            "items": {
                "type": "string"
            }
        },
        "data_categories": {
            "type": "array",
            "items": {
                "type": "string"
            }
        },
        "contexts": {
            "type": "array",
            "items": {
                "type": "string"
            }
        },
        "regions": {
            "type": "array",
            "items": {
                "type": "string"
            }
        },
        "consent": {
            "type": "object",
            "properties": {
                "required": {
                    "oneOf": [
                        {
                            "type": "boolean"
                        },
                        {
                            "const": "conditional"
                        }
                    ],
                    "$comment": "Deliberately not a plain boolean. 'conditional' means the answer depends on facts the matrix does not hold; a consumer that cannot represent it must surface it for a human rather than coerce it."
                },
                "conditions": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                },
                "withdrawal_required": {
                    "type": "boolean"
                }
            },
            "additionalProperties": false
        },
        "opt_out": {
            "type": "object",
            "properties": {
                "available": {
                    "type": "boolean"
                },
                "conditions": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                },
                "signals": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                }
            },
            "additionalProperties": false
        },
        "children": {
            "type": "object",
            "properties": {
                "applies": {
                    "type": "boolean"
                },
                "conditions": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                }
            },
            "additionalProperties": false
        },
        "exceptions": {
            "type": "array",
            "items": {
                "type": "string"
            }
        },
        "effective_from": {
            "type": [
                "string",
                "null"
            ],
            "format": "date"
        },
        "effective_to": {
            "type": [
                "string",
                "null"
            ],
            "format": "date"
        },
        "policy_version": {
            "type": "string",
            "minLength": 1
        },
        "source_ids": {
            "type": "array",
            "minItems": 1,
            "items": {
                "type": "string"
            }
        },
        "notes": {
            "type": "string"
        },
        "topic_canonical": {
            "type": "string",
            "$comment": "Canonical topic added by tools/normalise.mjs; the regime's own term stays in `topic`."
        },
        "legal_bases_canonical": {
            "type": "array",
            "items": {
                "type": "string"
            },
            "$comment": "Added by tools/normalise.mjs."
        },
        "data_categories_canonical": {
            "type": "array",
            "items": {
                "type": "string"
            },
            "$comment": "Added by tools/normalise.mjs."
        }
    },
    "additionalProperties": false,
    "description": "Shape of one requirement record in matrix/requirements.json. Enumerated values are NOT duplicated here: the authoritative list for topic, requirement_type, authority_level, legal_bases, data_categories, covered_actors and regions is schemas/vocabulary.json, and tools/validate.mjs checks records against it. Earlier revisions of this file carried its own enums, which drifted out of step with the vocabulary and would have rejected every record in the matrix; see matrix/coverage.md for what was found and changed."
}
