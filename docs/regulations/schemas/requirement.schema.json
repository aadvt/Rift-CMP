{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://example.com/rift-cmp/regulations/schemas/requirement.schema.json",
    "title": "Privacy Regulation Requirement",
    "type": "object",
    "required": [
        "requirement_id",
        "regime",
        "topic",
        "requirement",
        "applicability",
        "legal_bases",
        "purposes",
        "data_categories",
        "contexts",
        "exceptions",
        "effective_from",
        "effective_to",
        "policy_version",
        "source_ids"
    ],
    "properties": {
        "requirement_id": {
            "type": "string",
            "minLength": 1
        },
        "regime": {
            "type": "string",
            "minLength": 1
        },
        "topic": {
            "type": "string",
            "minLength": 1
        },
        "requirement": {
            "type": "string",
            "minLength": 1
        },
        "requirement_type": {
            "type": "string",
            "enum": [
                "statutory",
                "regulatory",
                "official_guidance",
                "derived_model"
            ]
        },
        "authority_level": {
            "type": "string",
            "enum": [
                "binding_law",
                "regulation",
                "official_guidance",
                "research_model"
            ]
        },
        "applicability": {
            "type": "object",
            "required": [
                "applies",
                "triggers",
                "covered_actors"
            ],
            "properties": {
                "applies": {
                    "type": "boolean"
                },
                "triggers": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                },
                "covered_actors": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                },
                "thresholds": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                },
                "territorial_triggers": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                },
                "sector_conditions": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                },
                "data_subject_conditions": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                }
            },
            "additionalProperties": false
        },
        "legal_bases": {
            "type": "array",
            "items": {
                "type": "string"
            }
        },
        "purposes": {
            "type": "array",
            "items": {
                "type": "string"
            }
        },
        "data_categories": {
            "type": "array",
            "items": {
                "type": "string"
            }
        },
        "contexts": {
            "type": "array",
            "items": {
                "type": "string"
            }
        },
        "regions": {
            "type": "array",
            "items": {
                "type": "string"
            }
        },
        "consent": {
            "type": "object",
            "properties": {
                "required": {
                    "type": "boolean"
                },
                "conditions": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                },
                "withdrawal_required": {
                    "type": "boolean"
                }
            },
            "additionalProperties": false
        },
        "opt_out": {
            "type": "object",
            "properties": {
                "available": {
                    "type": "boolean"
                },
                "conditions": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                },
                "signals": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                }
            },
            "additionalProperties": false
        },
        "children": {
            "type": "object",
            "properties": {
                "applies": {
                    "type": "boolean"
                },
                "conditions": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                }
            },
            "additionalProperties": false
        },
        "exceptions": {
            "type": "array",
            "items": {
                "type": "string"
            }
        },
        "effective_from": {
            "type": [
                "string",
                "null"
            ],
            "format": "date"
        },
        "effective_to": {
            "type": [
                "string",
                "null"
            ],
            "format": "date"
        },
        "policy_version": {
            "type": "string",
            "minLength": 1
        },
        "source_ids": {
            "type": "array",
            "minItems": 1,
            "items": {
                "type": "string"
            }
        },
        "notes": {
            "type": "string"
        }
    },
    "additionalProperties": false
}