{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://rift-cmp.local/schemas/requirement.schema.json",
    "title": "Privacy Regulation Requirement",
    "description": "Machine-readable schema for a privacy regulation requirement in Rift-CMP.",
    "type": "object",
    "required": [
        "requirement_id",
        "regime",
        "topic",
        "requirement",
        "applicability",
        "legal_bases",
        "purposes",
        "data_categories",
        "contexts",
        "exceptions",
        "effective_from",
        "policy_version",
        "source_ids"
    ],
    "properties": {
        "requirement_id": {
            "type": "string",
            "minLength": 1
        },
        "regime": {
            "type": "string",
            "minLength": 1
        },
        "topic": {
            "type": "string",
            "minLength": 1
        },
        "requirement": {
            "type": "string",
            "minLength": 1
        },
        "applicability": {
            "type": "object",
            "required": [
                "applies"
            ],
            "properties": {
                "applies": {
                    "type": "boolean"
                },
                "triggers": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                },
                "covered_actors": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                }
            },
            "additionalProperties": false
        },
        "legal_bases": {
            "type": "array",
            "items": {
                "type": "string"
            }
        },
        "purposes": {
            "type": "array",
            "items": {
                "type": "string"
            }
        },
        "data_categories": {
            "type": "array",
            "items": {
                "type": "string"
            }
        },
        "contexts": {
            "type": "array",
            "items": {
                "type": "string"
            }
        },
        "regions": {
            "type": "array",
            "items": {
                "type": "string"
            }
        },
        "consent": {
            "type": "object",
            "properties": {
                "required": {
                    "type": "boolean"
                },
                "conditions": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                },
                "withdrawal_required": {
                    "type": "boolean"
                }
            },
            "additionalProperties": false
        },
        "opt_out": {
            "type": "object",
            "properties": {
                "available": {
                    "type": "boolean"
                },
                "conditions": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                },
                "signals": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                }
            },
            "additionalProperties": false
        },
        "exceptions": {
            "type": "array",
            "items": {
                "type": "string"
            }
        },
        "children": {
            "type": "object",
            "properties": {
                "applies": {
                    "type": "boolean"
                },
                "conditions": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                }
            },
            "additionalProperties": false
        },
        "effective_from": {
            "type": [
                "string",
                "null"
            ],
            "format": "date"
        },
        "effective_to": {
            "type": [
                "string",
                "null"
            ],
            "format": "date"
        },
        "policy_version": {
            "type": "string",
            "minLength": 1
        },
        "source_ids": {
            "type": "array",
            "minItems": 1,
            "items": {
                "type": "string",
                "minLength": 1
            }
        },
        "notes": {
            "type": "string"
        }
    },
    "additionalProperties": false
}