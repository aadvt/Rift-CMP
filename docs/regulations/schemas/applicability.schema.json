{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://example.com/rift-cmp/regulations/schemas/applicability.schema.json",
    "title": "Privacy Regulation Applicability",
    "type": "object",
    "required": [
        "applies",
        "triggers",
        "covered_actors"
    ],
    "properties": {
        "applies": {
            "type": "boolean"
        },
        "triggers": {
            "type": "array",
            "items": {
                "type": "string"
            }
        },
        "covered_actors": {
            "type": "array",
            "items": {
                "type": "string"
            }
        },
        "thresholds": {
            "type": "array",
            "items": {
                "type": "object",
                "required": [
                    "type",
                    "condition"
                ],
                "properties": {
                    "type": {
                        "type": "string"
                    },
                    "condition": {
                        "type": "string"
                    },
                    "value": {
                        "type": [
                            "string",
                            "number",
                            "boolean",
                            "null"
                        ]
                    },
                    "unit": {
                        "type": [
                            "string",
                            "null"
                        ]
                    }
                },
                "additionalProperties": false
            }
        },
        "territorial_triggers": {
            "type": "array",
            "items": {
                "type": "string"
            }
        },
        "entity_types": {
            "type": "array",
            "items": {
                "type": "string"
            }
        },
        "data_subject_conditions": {
            "type": "array",
            "items": {
                "type": "string"
            }
        },
        "data_conditions": {
            "type": "array",
            "items": {
                "type": "string"
            }
        },
        "processing_conditions": {
            "type": "array",
            "items": {
                "type": "string"
            }
        },
        "sector_conditions": {
            "type": "array",
            "items": {
                "type": "string"
            }
        },
        "exemptions": {
            "type": "array",
            "items": {
                "type": "string"
            }
        },
        "effective_from": {
            "type": [
                "string",
                "null"
            ],
            "format": "date"
        },
        "effective_to": {
            "type": [
                "string",
                "null"
            ],
            "format": "date"
        },
        "conditions": {
            "type": "array",
            "items": {
                "type": "string"
            }
        },
        "notes": {
            "type": [
                "string",
                "null"
            ]
        }
    },
    "additionalProperties": false
}