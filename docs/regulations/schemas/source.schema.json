{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://example.com/rift-cmp/regulations/schemas/source.schema.json",
    "title": "Privacy Regulation Source",
    "type": "object",
    "required": [
        "source_id",
        "regime",
        "title",
        "source_type",
        "authority",
        "publisher",
        "url",
        "retrieved_date"
    ],
    "properties": {
        "source_id": {
            "type": "string",
            "minLength": 1
        },
        "regime": {
            "type": "string",
            "minLength": 1
        },
        "title": {
            "type": "string",
            "minLength": 1
        },
        "source_type": {
            "type": "string",
            "enum": [
                "primary",
                "primary_regulatory",
                "official_information",
                "official_guidance",
                "independent_authoritative",
                "derived_model"
            ]
        },
        "authority": {
            "type": "string",
            "minLength": 1
        },
        "publisher": {
            "type": "string",
            "minLength": 1
        },
        "publication_date": {
            "type": [
                "string",
                "null"
            ],
            "format": "date"
        },
        "effective_date": {
            "type": [
                "string",
                "null"
            ],
            "format": "date"
        },
        "application_date": {
            "type": [
                "string",
                "null"
            ],
            "format": "date"
        },
        "version": {
            "type": [
                "string",
                "null"
            ]
        },
        "url": {
            "type": [
                "string",
                "null"
            ],
            "format": "uri"
        },
        "retrieved_date": {
            "type": "string",
            "format": "date"
        },
        "notes": {
            "type": [
                "string",
                "null"
            ]
        }
    },
    "additionalProperties": false
}