{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      // The dashboard's intelligence components are rendered by
      // `tests/intelligence-ui.test.tsx`, and they import their wire types as
      // `@/lib/api/backend` — where `@` means the dashboard app, not this one.
      // Two projects legitimately own the same alias, so the shared module is
      // named explicitly; it wins over the wildcard by specificity, and this
      // app has no `lib/api/backend` of its own to shadow.
      "@/lib/api/backend": ["../rift-frontend-main/apps/dashboard/lib/api/backend.ts"],
      "@/*": ["./*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
  ],
  // `next build` type-checks everything `include` reaches, and these two files
  // import dashboard components from `rift-frontend-main` — a *separate* npm
  // workspace root whose `node_modules` exist on a developer machine and inside
  // the dashboard image, but not inside the api image, which installs only the
  // root workspace.
  //
  // The result was an api image that built locally and failed in Docker with
  // "Cannot find module '@rift/ui'". It went unnoticed because `npx next build`
  // resolves them fine here.
  //
  // They are still fully type-checked: `npm run typecheck` uses
  // `tsconfig.typecheck.json`, which puts them back. This exclusion narrows what
  // the *bundler* compiles, not what is verified.
  "exclude": [
    "node_modules",
    "tests/intelligence-ui.test.tsx",
    "tests/enforcement-ui.test.tsx",
    "tests/preview-recommendations.test.ts"
  ]
}
