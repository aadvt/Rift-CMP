{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      // The dashboard's intelligence components are rendered by
      // `tests/intelligence-ui.test.tsx`, and they import their wire types as
      // `@/lib/api/backend` — where `@` means the dashboard app, not this one.
      // Two projects legitimately own the same alias, so the shared module is
      // named explicitly; it wins over the wildcard by specificity, and this
      // app has no `lib/api/backend` of its own to shadow.
      "@/lib/api/backend": ["../rift-frontend-main/apps/dashboard/lib/api/backend.ts"],
      "@/*": ["./*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
  ],
  "exclude": ["node_modules"]
}
