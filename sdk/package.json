{
  "name": "@rift-cmp/sdk",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "exports": {
    ".": "./dist/index.js"
  },
  "scripts": {
    "build": "tsup src/index.ts --format iife --global-name __riftCmpBundle --target es2022 --out-dir dist --minify && npm run verify",
    "verify": "node scripts/verify-global.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@rift-cmp/shared": "*"
  },
  "devDependencies": {
    "tsup": "^8.1.10",
    "typescript": "^5.6.2"
  }
}
